{
	"name": "n8n-nodes-compasslab-email-validator",
	"version": "0.1.3",
	"description": "n8n node for Email Validator with MX and Disposable Check (CompassLab): Validate email addresses: syntax, MX records, disposable and role addresses, free providers, typo suggestions.",
	"license": "MIT",
	"homepage": "https://github.com/THEMAGNET-NICHEP-Lab/n8n-nodes-compasslab-email-validator#readme",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"compasslab",
		"email validation",
		"email verifier",
		"mx check",
		"disposable email",
		"list cleaning"
	],
	"author": {
		"name": "CompassLab",
		"email": "jaouchamouad@proton.me"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/THEMAGNET-NICHEP-Lab/n8n-nodes-compasslab-email-validator.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public"
	},
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/CompassLabEmailValidatorApiMarketApi.credentials.js",
			"dist/credentials/CompassLabEmailValidatorRapidApiApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/CompassLabEmailValidator/CompassLabEmailValidator.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "^0.50.4",
		"eslint": "9.39.4",
		"prettier": "3.8.3",
		"release-it": "20.2.0",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
