{
	"name": "n8n-nodes-compasslab-phone-validator",
	"version": "0.1.2",
	"description": "n8n node for Phone Number Validator and Formatter (CompassLab): Validate and format phone numbers from any country: E.164, national format, type, country, region, time zone.",
	"license": "MIT",
	"homepage": "https://github.com/THEMAGNET-NICHEP-Lab/n8n-nodes-compasslab-phone-validator#readme",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"compasslab",
		"phone validation",
		"phone number formatter",
		"e164",
		"libphonenumber",
		"crm cleanup"
	],
	"author": {
		"name": "CompassLab",
		"email": "jaouchamouad@proton.me"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/THEMAGNET-NICHEP-Lab/n8n-nodes-compasslab-phone-validator.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public"
	},
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/CompassLabPhoneValidatorApiMarketApi.credentials.js",
			"dist/credentials/CompassLabPhoneValidatorRapidApiApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/CompassLabPhoneValidator/CompassLabPhoneValidator.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "^0.50.4",
		"eslint": "9.39.4",
		"prettier": "3.8.3",
		"release-it": "20.2.0",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
