{
	"name": "n8n-nodes-compasslab-qr-barcode",
	"version": "0.1.1",
	"description": "n8n node for QR Code and Barcode Generator and Reader (CompassLab): Generate QR codes and EAN-13, UPC-A, Code 128, Code 39 barcodes (PNG or SVG), and read them from images.",
	"license": "MIT",
	"homepage": "https://github.com/THEMAGNET-NICHEP-Lab/n8n-nodes-compasslab/tree/main/packages/n8n-nodes-compasslab-qr-barcode#readme",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"compasslab",
		"qr code",
		"barcode",
		"qr code generator",
		"barcode reader",
		"ean13"
	],
	"author": {
		"name": "CompassLab",
		"email": "jaouchamouad@proton.me"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/THEMAGNET-NICHEP-Lab/n8n-nodes-compasslab.git",
		"directory": "packages/n8n-nodes-compasslab-qr-barcode"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public"
	},
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/CompassLabQrBarcodeApiMarketApi.credentials.js",
			"dist/credentials/CompassLabQrBarcodeRapidApiApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/CompassLabQrBarcode/CompassLabQrBarcode.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "^0.50.4",
		"eslint": "9.39.4",
		"prettier": "3.8.3",
		"release-it": "20.2.0",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
