{
	"name": "n8n-nodes-compasslab-holidays",
	"version": "0.1.0",
	"description": "n8n node for Public Holidays and Business Days (CompassLab): Public holidays for 250 countries and regions, plus business-day math: is it a working day, add days, count days.",
	"license": "MIT",
	"homepage": "https://github.com/THEMAGNET-NICHEP-Lab/n8n-nodes-compasslab/tree/main/packages/n8n-nodes-compasslab-holidays#readme",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"compasslab",
		"public holidays",
		"business days",
		"working days",
		"due date",
		"calendar"
	],
	"author": {
		"name": "CompassLab",
		"email": "jaouchamouad@proton.me"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/THEMAGNET-NICHEP-Lab/n8n-nodes-compasslab.git",
		"directory": "packages/n8n-nodes-compasslab-holidays"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public"
	},
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/CompassLabHolidaysApiMarketApi.credentials.js",
			"dist/credentials/CompassLabHolidaysRapidApiApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/CompassLabHolidays/CompassLabHolidays.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "^0.50.4",
		"eslint": "9.39.4",
		"prettier": "3.8.3",
		"release-it": "20.2.0",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
