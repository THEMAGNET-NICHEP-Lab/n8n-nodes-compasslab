{
	"name": "n8n-nodes-compasslab-pdf-to-text",
	"version": "0.1.1",
	"description": "n8n node for PDF to Text and Markdown (CompassLab): Extract the text of a PDF (URL or file) as plain text, Markdown or page by page, with metadata and scanned-page flags.",
	"license": "MIT",
	"homepage": "https://github.com/THEMAGNET-NICHEP-Lab/n8n-nodes-compasslab/tree/main/packages/n8n-nodes-compasslab-pdf-to-text#readme",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"compasslab",
		"pdf to text",
		"pdf to markdown",
		"pdf extraction",
		"pdf parser",
		"rag"
	],
	"author": {
		"name": "CompassLab",
		"email": "jaouchamouad@proton.me"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/THEMAGNET-NICHEP-Lab/n8n-nodes-compasslab.git",
		"directory": "packages/n8n-nodes-compasslab-pdf-to-text"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public"
	},
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/CompassLabPdfToTextApiMarketApi.credentials.js",
			"dist/credentials/CompassLabPdfToTextRapidApiApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/CompassLabPdfToText/CompassLabPdfToText.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "^0.50.4",
		"eslint": "9.39.4",
		"prettier": "3.8.3",
		"release-it": "20.2.0",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
